{
  "name": "potion-panic-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:build": "vitepress build Docs",
    "docs:dev": "vitepress dev Docs --host 0.0.0.0 --port 6420",
    "docs:dev:local": "vitepress dev Docs --host 127.0.0.1 --port 6420",
    "docs:preview": "vitepress preview Docs --host 0.0.0.0 --port 6421",
    "docs:startup:install": "node Scripts/docs/run-windows-startup-installer.mjs",
    "docs:startup:uninstall": "node Scripts/docs/run-windows-startup-installer.mjs -Uninstall",
    "docs:stop": "node Scripts/docs/run-windows-docs-stop.mjs",
    "docs:ticket": "docboard create-ticket",
    "docs:ui": "docboard open-board --url http://127.0.0.1:6420/PotionPanic/board --script docs:dev",
    "test": "node --test \"Scripts/docs/**/*.test.mjs\"",
    "docboard": "docboard",
    "docboard:open": "docboard open-board --script docs:dev --repo-root .",
    "docboard:create-ticket": "docboard create-ticket --board docs/board.md --dir docs/tickets"
  },
  "devDependencies": {
    "@gabrielwawerski/docboard": "file:../Docboard",
    "gray-matter": "^4.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.39"
  }
}
