root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on
ij_formatter_tags_enabled = true

[*.{cs,csx}]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 80

[*.{shader,compute,hlsl,cginc}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{json,asmdef,asmref,inputactions,shadergraph,shadersubgraph,yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{uxml,uss,tss,xml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{md,markdown}]
trim_trailing_whitespace = true
max_line_length = 80