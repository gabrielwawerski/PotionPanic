{
  "name": "potion-panic-coordination",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATION_OBJECT",
        "class_name": "CoordinationObject"
      }
    ]
  },
  "exports": {
    "CoordinationObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["TOKEN_HMAC_KEY", "ADMIN_TOKEN"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
